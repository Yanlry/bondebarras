{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Couche 3D : React Three Fiber mute volontairement les objets three.js
      // dans useFrame (à chaque frame, sans re-rendu React) : c'est le modèle prévu.
      "files": ["src/three/**", "src/sections/**/*Scene.tsx"],
      "rules": { "react/immutability": "off" }
    }
  ]
}
